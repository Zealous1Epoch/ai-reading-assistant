# LLM API 配置（变量名保留 DEEPSEEK_ 前缀 = 历史兼容，实际指向任意 OpenAI 兼容端点）
# 当前使用公司内部部署模型（vLLM，OpenAI 兼容），key 向管理员索取
DEEPSEEK_API_KEY="你的内部模型 key"
DEEPSEEK_BASE_URL=http://110.90.4.74:26030/v1
DEEPSEEK_MODEL=qwen3.8-flash-next

# 应用配置
APP_NAME=智能读书助手
APP_ENV=development
DEBUG=true

# 数据库配置（可选，用于保存用户数据和读书笔记）
DATABASE_URL=sqlite:///./data/books.db

# Redis配置（可选，用于缓存和会话管理）
REDIS_URL=redis://localhost:6379/0
